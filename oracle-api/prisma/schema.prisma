// --- Phase 4: CCTV / NVR inventory foundation ---
// Metadata only. Never stores camera/NVR passwords, stream URLs, footage, or
// exported device configuration. CameraProfile/RecorderChannel intentionally
// omit a network-interface/port linkage in this isolated branch because that
// linkage depends on NetworkInterface/NetworkPort models owned by an
// unmerged networking phase; add it back once that phase lands on main.

model CameraProfile {
  id                     String                    @id @default(cuid())
  assetId                String                    @unique
  physicalLocation       String
  coverageArea           String?
  cameraType             CameraType                @default(fixed)
  resolution             String?
  nightVision            Boolean?
  motionDetection        Boolean?
  installationDate       DateTime?
  notes                  String?
  idempotencyKey         String?                   @unique
  idempotencyPayloadHash String?
  secretReferences       AssetSecretReference[]    @relation("CameraSecretReferences")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  asset                  Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignments            CameraChannelAssignment[]

  @@index([physicalLocation])
}

model RecorderProfile {
  id                     String            @id @default(cuid())
  assetId                String            @unique
  recorderType           RecorderType      @default(nvr)
  channelCapacity        Int
  physicalLocation       String
  storageCapacityBytes   BigInt?
  retentionDaysTarget    Int?
  notes                  String?
  idempotencyKey         String?           @unique
  idempotencyPayloadHash String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  asset                  Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channels               RecorderChannel[]

  @@index([physicalLocation])
}

model RecorderChannel {
  id            String                    @id @default(cuid())
  recorderId    String
  channelNumber Int
  label         String?
  enabled       Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  recorder      RecorderProfile           @relation(fields: [recorderId], references: [id], onDelete: Cascade)
  assignments   CameraChannelAssignment[]

  @@unique([recorderId, channelNumber])
}

model CameraChannelAssignment {
  id                     String          @id @default(cuid())
  cameraId               String
  channelId              String
  validFrom              DateTime        @default(now())
  validTo                DateTime?
  notes                  String?
  idempotencyKey         String?         @unique
  idempotencyPayloadHash String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  camera                 CameraProfile   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  channel                RecorderChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([cameraId, validFrom])
  @@index([channelId, validFrom])
}

model SecretReference {
  id           String                      @id @default(cuid())
  provider     String
  referenceId  String
  displayLabel String?
  system       String?
  ownerTeam    String?
  rotationAt   DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  assets       AssetSecretReference[]      @relation("SecretReferenceLinks")
  circuits     IspCircuitSecretReference[]

  @@unique([provider, referenceId])
}

model AssetSecretReference {
  id                String          @id @default(cuid())
  assetId           String
  secretReferenceId String
  cameraProfileId   String?
  createdAt         DateTime        @default(now())
  asset             Asset           @relation("AssetSecretReferences", fields: [assetId], references: [id], onDelete: Cascade)
  secretReference   SecretReference @relation("SecretReferenceLinks", fields: [secretReferenceId], references: [id], onDelete: Cascade)
  cameraProfile     CameraProfile?  @relation("CameraSecretReferences", fields: [cameraProfileId], references: [id], onDelete: Cascade)

  @@unique([assetId, secretReferenceId, cameraProfileId])
  @@index([secretReferenceId])
}

enum CameraType {
  fixed
  dome
  bullet
  ptz
  thermal
  other
}

enum RecorderType {
  nvr
  dvr
  hybrid
  other
}

// --- Access Point / Switch inventory ---
// Metadata only — IP/subnet/gateway/DNS reuse NetworkInterface +
// IpAddressObservation, VLAN membership reuses InterfaceVlanAssignment,
// physical ports reuse NetworkPort, and credentials reuse SecretReference
// via Asset.secretReferences. These profiles hold only the identity fields
// that don't already have a generic home elsewhere.

model AccessPointProfile {
  id                     String   @id @default(cuid())
  assetId                String   @unique
  physicalLocation       String
  notes                  String?
  idempotencyKey         String?  @unique
  idempotencyPayloadHash String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  asset                  Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([physicalLocation])
}

model SwitchProfile {
  id                     String     @id @default(cuid())
  assetId                String     @unique
  switchType             SwitchType @default(unmanaged)
  physicalLocation       String
  portCount              Int?
  notes                  String?
  idempotencyKey         String?    @unique
  idempotencyPayloadHash String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  asset                  Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([physicalLocation])
}

enum SwitchType {
  managed
  unmanaged
}

// --- Phone inventory ---
// Company vs BYOD reuses Asset.ownership (company/personal) instead of a
// second type field. Serial number, IMEI, and property tag already live on
// Asset. Only brand/model need a category-specific home.

model PhoneProfile {
  id                     String   @id @default(cuid())
  assetId                String   @unique
  brand                  String?
  model                  String?
  notes                  String?
  idempotencyKey         String?  @unique
  idempotencyPayloadHash String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  asset                  Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// --- Phase 5: Servers, firewall, and ISP circuit inventory ---
// Metadata only. Never stores server/firewall/ISP credentials, ruleset
// exports, or raw configuration — SecretReference is the only pointer to
// secret material, matching the Phase 4 invariant. FirewallProfile links to
// NetworkInterface (Phase 3) and IspCircuitSecretReference links to
// SecretReference (Phase 4) now that both phases are merged in.

model ServerProfile {
  id                     String                 @id @default(cuid())
  assetId                String                 @unique
  environment            ServerEnvironment
  criticality            Criticality
  virtualizationRole     VirtualizationRole
  serviceOwner           String
  supportOwner           String?
  purpose                String?
  idempotencyKey         String?                @unique
  idempotencyPayloadHash String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  asset                  Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  roles                  ServerRoleAssignment[]
}

model ServerRoleAssignment {
  id                     String         @id @default(cuid())
  serverId               String
  roleType               ServerRoleType
  roleName               String?
  domainName             String?
  isPrimary              Boolean        @default(false)
  validFrom              DateTime       @default(now())
  validTo                DateTime?
  notes                  String?
  idempotencyKey         String?        @unique
  idempotencyPayloadHash String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  server                 ServerProfile  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, validFrom])
}

model FirewallProfile {
  id                       String                 @id @default(cuid())
  assetId                  String                 @unique
  deploymentMode           FirewallDeploymentMode
  haRole                   FirewallHaRole
  policyOwner              String
  configurationArtifactRef String?
  idempotencyKey           String?                @unique
  idempotencyPayloadHash   String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  asset                    Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model IspCircuit {
  id                      String                       @id @default(cuid())
  branchId                String
  providerName            String
  circuitLabel            String
  serviceType             IspServiceType
  status                  IspCircuitStatus
  demarcLocation          String?
  downloadMbps            Decimal
  uploadMbps              Decimal
  addressingMode          IspAddressingMode
  isSharedService         Boolean                      @default(false)
  sharedServiceReason     String?
  activatedAt             DateTime?
  terminatedAt            DateTime?
  providerCircuitIdMasked String?
  idempotencyKey          String?                      @unique
  idempotencyPayloadHash  String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  branch                  Branch                       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  equipment               CircuitEquipmentAssignment[]
  addresses               IspCircuitAddress[]
  secretReferences        IspCircuitSecretReference[]

  @@index([branchId, status])
}

model CircuitEquipmentAssignment {
  id                     String               @id @default(cuid())
  circuitId              String
  assetId                String
  role                   CircuitEquipmentRole
  validFrom              DateTime             @default(now())
  validTo                DateTime?
  idempotencyKey         String?              @unique
  idempotencyPayloadHash String?
  sharedServiceApproved  Boolean              @default(false)
  sharedServiceReason    String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  circuit                IspCircuit           @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  asset                  Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([circuitId, validFrom])
}

model IspCircuitAddress {
  id                     String     @id @default(cuid())
  circuitId              String
  address                String
  prefixLength           Int
  gateway                String?
  validFrom              DateTime   @default(now())
  validTo                DateTime?
  idempotencyKey         String?    @unique
  idempotencyPayloadHash String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  circuit                IspCircuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@index([circuitId, validFrom])
}

model IspCircuitSecretReference {
  id                     String          @id @default(cuid())
  circuitId              String
  secretReferenceId      String
  purpose                String?
  idempotencyKey         String?         @unique
  idempotencyPayloadHash String?
  createdAt              DateTime        @default(now())
  circuit                IspCircuit      @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  secretReference        SecretReference @relation(fields: [secretReferenceId], references: [id], onDelete: Cascade)

  @@unique([circuitId, secretReferenceId])
}

