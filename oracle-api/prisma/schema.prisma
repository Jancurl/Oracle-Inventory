generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       SystemUser[]
}

model Permission {
  id            String           @id @default(cuid())
  key           String           @unique
  description   String?
  roles         RolePermission[]
  userOverrides UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model SystemUser {
  id                      String                 @id @default(cuid())
  name                    String
  email                   String                 @unique
  password                String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  phone                   String?
  position                String?
  roleId                  String?
  status                  UserStatus             @default(active)
  mustChangePassword      Boolean                @default(false)
  branchId                String?
  activityLogs            ActivityLog[]
  mappingPresets          ColumnMappingPreset[]
  importHistory           ImportHistory[]
  scanRooms               ScanRoom[]
  submittedHwScans        HardwareScan[]         @relation("HardwareScanSubmitter")
  reviewedHwScans         HardwareScan[]         @relation("HardwareScanReviewer")
  branch                  Branch?                @relation(fields: [branchId], references: [id])
  role                    Role?                  @relation(fields: [roleId], references: [id])
  permissionOverrides     UserPermission[]
  intakeDrafts            ComputerIntakeDraft[]
  reviewedObservations    InventoryObservation[] @relation("InventoryObservationReviewer")
  rolloutChanges          FeatureRollout[]       @relation("FeatureRolloutUpdater")
  rolloutBranchChanges    FeatureRolloutBranch[] @relation("FeatureRolloutBranchUpdater")
  stockMovementsPerformed StockMovement[]        @relation("StockMovementPerformedBy")
  stockMovementsApproved  StockMovement[]        @relation("StockMovementApprovedBy")
  stockCountsStarted      StockCountSession[]    @relation("StockCountStartedBy")
  stockCountsApproved     StockCountSession[]    @relation("StockCountApprovedBy")
  deviceCredentialChanges NetworkDeviceCredential[] @relation("NetworkDeviceCredentialUpdater")
  uploadedAttachments     AssetAttachment[]
  avatar                  UserAvatar?
}

// Profile photo of a login account. Kept apart from SystemUser so that
// listing users never loads image bytes.
model UserAvatar {
  userId    String     @id
  mimeType  String
  data      Bytes
  updatedAt DateTime   @updatedAt
  user      SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model ActivityLog {
  id        String      @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())
  user      SystemUser? @relation(fields: [userId], references: [id])
}

model Branch {
  id               String                 @id @default(cuid())
  name             String
  address          String?
  latitude         Float?
  longitude        Float?
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  assets           Asset[]
  employees        Employee[]
  departments      Department[]
  users            SystemUser[]
  intakeDrafts     ComputerIntakeDraft[]
  featureOverrides FeatureRolloutBranch[]
  stockLocations   StockLocation[]
  ispCircuits      IspCircuit[]
  networkNodes     NetworkNode[]
}

model FeatureRollout {
  id              String                 @id @default(cuid())
  key             String                 @unique
  enabledGlobally Boolean                @default(false)
  status          RolloutStatus          @default(disabled)
  minimumRole     String?
  configVersion   Int                    @default(1)
  updatedById     String?
  updatedAt       DateTime               @updatedAt
  createdAt       DateTime               @default(now())
  updatedBy       SystemUser?            @relation("FeatureRolloutUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  branchOverrides FeatureRolloutBranch[]
}

model FeatureRolloutBranch {
  id          String         @id @default(cuid())
  featureKey  String
  branchId    String
  enabled     Boolean
  reason      String?
  updatedById String?
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())
  feature     FeatureRollout @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  updatedBy   SystemUser?    @relation("FeatureRolloutBranchUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([featureKey, branchId])
  @@index([branchId])
}

model Department {
  id         String     @id @default(cuid())
  name       String
  branchId   String
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  branch     Branch     @relation(fields: [branchId], references: [id])
  employees  Employee[]

  @@index([archivedAt])
  @@index([branchId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  assets    Asset[]
}

model Employee {
  id             String            @id @default(cuid())
  name           String
  email          String?           @unique
  phone          String?
  employeeId     String?           @unique
  departmentId   String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  branchId       String?
  source         String            @default("manual")
  position       String?
  assignments    AssetAssignment[]
  branch         Branch?           @relation(fields: [branchId], references: [id])
  department     Department?       @relation(fields: [departmentId], references: [id])
  movementLogs   MovementLog[]
  stockMovements StockMovement[]
  photo          EmployeePhoto?
}

// Profile photo of an employee record, kept apart from Employee so that
// listing employees never loads image bytes.
model EmployeePhoto {
  employeeId String   @id
  mimeType   String
  data       Bytes
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Asset {
  id                  String                       @id @default(cuid())
  name                String
  serialNumber        String?
  categoryId          String?
  condition           AssetCondition               @default(usable)
  ownership           OwnershipType                @default(company)
  description         String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  nextMaintenanceDate DateTime?
  warrantyExpiry      DateTime?
  assetTag            String?
  branchId            String?
  computerName        String?
  imeiNumber          String?
  importId            String?
  macAddress          String?
  metadata            Json?
  propertyTag         String?
  lostAt              DateTime?
  lostStolenNotes     String?
  status              AssetStatus                  @default(active)
  notifiedDue         DateTime?
  notifiedReminder    DateTime?
  purchaseDate        DateTime?
  branch              Branch?                      @relation(fields: [branchId], references: [id])
  category            Category?                    @relation(fields: [categoryId], references: [id])
  importHistory       ImportHistory?               @relation(fields: [importId], references: [id])
  assignments         AssetAssignment[]
  movementLogs        MovementLog[]
  hardwareScans       HardwareScan[]
  deviceProfile       DeviceProfile?
  components          AssetComponent[]
  observations        InventoryObservation[]
  stockMovements      StockMovement[]
  cameraProfile       CameraProfile?
  recorderProfile     RecorderProfile?
  accessPointProfile  AccessPointProfile?
  switchProfile       SwitchProfile?
  phoneProfile        PhoneProfile?
  secretReferences    AssetSecretReference[]       @relation("AssetSecretReferences")
  deviceCredential    NetworkDeviceCredential?
  networkConnection   DeviceConnection?
  proposals           InventoryFieldProposal[]
  serverProfile       ServerProfile?
  firewallProfile     FirewallProfile?
  circuitEquipment    CircuitEquipmentAssignment[]
  attachments         AssetAttachment[]
}

model AssetAttachment {
  id           String     @id @default(cuid())
  assetId      String
  fileName     String
  mimeType     String
  fileSize     Int
  data         Bytes
  uploadedById String
  createdAt    DateTime   @default(now())
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy   SystemUser @relation(fields: [uploadedById], references: [id])

  @@index([assetId])
}

model DeviceProfile {
  id               String           @id @default(cuid())
  assetId          String           @unique
  deviceType       DeviceType       @default(computer)
  brand            String?
  model            String?
  deviceSerial     String?
  processor        String?
  motherboard      String?
  operatingSystem  String?
  osVersion        String?
  osInstallDate    DateTime?
  source           String           @default("manual")
  sourceObservedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  asset            Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  components       AssetComponent[]

  @@index([deviceType])
}

model AssetComponent {
  id               String         @id @default(cuid())
  assetId          String
  deviceProfileId  String?
  type             ComponentType
  slotOrBay        String?
  brand            String?
  model            String?
  serialNumber     String?
  capacity         String?
  storageKind      String?
  propertyTag      String?
  source           String         @default("manual")
  sourceObservedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  asset            Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceProfile    DeviceProfile? @relation(fields: [deviceProfileId], references: [id], onDelete: SetNull)

  @@index([assetId, type])
}

model InventoryObservation {
  id           String            @id @default(cuid())
  assetId      String
  source       String
  status       ObservationStatus @default(proposed)
  fields       Json
  observedAt   DateTime          @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime          @default(now())
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviewedBy   SystemUser?       @relation("InventoryObservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([assetId, status])
}

model ComputerIntakeDraft {
  id                   String      @id @default(cuid())
  createdById          String
  branchId             String?
  status               DraftStatus @default(draft)
  data                 Json
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  submittedAt          DateTime?
  submittedAssetId     String?
  submitIdempotencyKey String?     @unique
  submitPayloadHash    String?
  createdBy            SystemUser  @relation(fields: [createdById], references: [id])
  branch               Branch?     @relation(fields: [branchId], references: [id])

  @@index([createdById, status])
  @@index([branchId, status])
}

// --- Network map ---
// Where each employee laptop/desktop connects. A NetworkNode is one box on the
// map (ISP line, firewall, managed switch, switch). Switches point at the
// managed switch they uplink to and managed switches at their firewall, so a
// computer only records its switch + port and the managed switch / firewall
// follow from the tree. ISPs are chosen per computer because a firewall with
// two lines can route different computers out different ISPs.

model NetworkNode {
  id                String             @id @default(cuid())
  branchId          String
  type              NetworkNodeType
  name              String
  parentId          String?
  // Port on the parent that this node's uplink cable plugs into.
  parentPort        String?
  portCount         Int?
  brand             String?
  model             String?
  serialNumber      String?
  location          String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parent            NetworkNode?       @relation("NetworkNodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          NetworkNode[]      @relation("NetworkNodeTree")
  switchConnections DeviceConnection[] @relation("DeviceConnectionSwitch")
  ispConnections    DeviceConnection[] @relation("DeviceConnectionIsp")

  @@unique([branchId, name])
  @@index([branchId, type])
  @@index([parentId])
}

enum NetworkNodeType {
  isp
  firewall
  managed_switch
  switch
}

enum NetworkConnectionType {
  wired
  wifi
}

// One row per laptop/desktop. Wired: switchId + switchPort + ispId.
// Wi-Fi: ispId only.
model DeviceConnection {
  id             String                @id @default(cuid())
  assetId        String                @unique
  connectionType NetworkConnectionType
  switchId       String?
  switchPort     String?
  ispId          String?
  notes          String?
  updatedById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  asset          Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  switch         NetworkNode?          @relation("DeviceConnectionSwitch", fields: [switchId], references: [id], onDelete: SetNull)
  isp            NetworkNode?          @relation("DeviceConnectionIsp", fields: [ispId], references: [id], onDelete: SetNull)

  @@index([switchId, switchPort])
  @@index([ispId])
}

// Optional device credentials for a network asset (switch/AP/router logins,
// SNMP communities, VPN pre-shared keys, Wi-Fi passwords, API keys, recovery
// codes). All secret values are encrypted (AES-256-GCM) as a single JSON blob
// before storage; the has* flags let the UI show what's populated without
// decrypting. Decryption is gated to super_admin via a dedicated reveal route.
model NetworkDeviceCredential {
  id               String      @id @default(cuid())
  assetId          String      @unique
  ciphertext       String
  iv               String
  tag              String
  hasUsername      Boolean     @default(false)
  hasPassword      Boolean     @default(false)
  hasSnmpCommunity Boolean     @default(false)
  hasVpnKey        Boolean     @default(false)
  hasWifiPassword  Boolean     @default(false)
  hasApiKey        Boolean     @default(false)
  hasRecoveryCode  Boolean     @default(false)
  updatedById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  asset            Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  updatedBy        SystemUser? @relation("NetworkDeviceCredentialUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

enum DeviceType {
  computer
  laptop
}

enum ComponentType {
  ram
  storage
  monitor
  keyboard
  mouse
  speaker
  webcam
  microphone
  printer
  ups
  avr
  clicker
  projector
  tv
  signal_booster
  flash_drive
  external_hdd
  hdd_ssd_docking_station
  nvme_docking_station
}

enum ObservationStatus {
  proposed
  verified
  conflict
  rejected
}

enum DraftStatus {
  draft
  submitted
  cancelled
}

model HardwareScan {
  id                String                   @id @default(cuid())
  assetId           String
  submittedById     String
  fileName          String
  rawHtml           String
  rawHtmlCiphertext String?
  rawHtmlIv         String?
  rawHtmlTag        String?
  rawRetentionMode  String?
  retentionUntil    DateTime?
  purgedAt          DateTime?
  parsedSpecs       Json
  isBaseline        Boolean                  @default(false)
  comparisonResult  Json?
  overallStatus     HwComparisonStatus?
  status            HardwareScanStatus       @default(pending)
  reviewedById      String?
  reviewedAt        DateTime?
  parserVersion     String?
  sourceProduct     String?
  contentSha256     String?
  idempotencyKey    String?
  reviewNotes       String?
  createdAt         DateTime                 @default(now())
  asset             Asset                    @relation(fields: [assetId], references: [id])
  submittedBy       SystemUser               @relation("HardwareScanSubmitter", fields: [submittedById], references: [id])
  reviewedBy        SystemUser?              @relation("HardwareScanReviewer", fields: [reviewedById], references: [id])
  proposals         InventoryFieldProposal[]

  @@unique([assetId, idempotencyKey])
  @@index([assetId, isBaseline])
}

model InventoryFieldProposal {
  id                        String             @id @default(cuid())
  hardwareScanId            String
  assetId                   String
  fieldKey                  String
  targetType                String
  targetRecordId            String
  proposedValueJson         Json
  officialValueSnapshotJson Json?
  state                     ProposalState      @default(proposed)
  sourceConfidence          ProposalConfidence @default(observed)
  resolvedById              String?
  resolvedAt                DateTime?
  reason                    String?
  lastIdempotencyKey        String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  hardwareScan              HardwareScan       @relation(fields: [hardwareScanId], references: [id], onDelete: Cascade)
  asset                     Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, state])
  @@index([hardwareScanId, fieldKey])
}

model AssetAssignment {
  id                String           @id @default(cuid())
  assetId           String
  employeeId        String
  status            AssignmentStatus @default(active)
  assignedAt        DateTime         @default(now())
  returnedAt        DateTime?
  notes             String?
  returnNotes       String?
  returnRequestedAt DateTime?
  returnRequestedBy String?
  asset             Asset            @relation(fields: [assetId], references: [id])
  employee          Employee         @relation(fields: [employeeId], references: [id])
}

model MovementLog {
  id         String       @id @default(cuid())
  assetId    String
  employeeId String?
  type       MovementType
  notes      String?
  createdAt  DateTime     @default(now())
  asset      Asset        @relation(fields: [assetId], references: [id])
  employee   Employee?    @relation(fields: [employeeId], references: [id])
}

model ImportHistory {
  id                 String       @id @default(cuid())
  uploadedById       String
  fileName           String
  fileSize           Int
  totalRows          Int          @default(0)
  importedRows       Int          @default(0)
  skippedRows        Int          @default(0)
  failedRows         Int          @default(0)
  duplicatesSkipped  Int          @default(0)
  categoriesCreated  Int          @default(0)
  editedBeforeImport Int          @default(0)
  overwrittenRows    Int          @default(0)
  strictMode         Boolean      @default(false)
  status             ImportStatus @default(pending)
  createdAt          DateTime     @default(now())
  mappingUsed        Json?
  assetsCreated      Int          @default(0)
  assetsDuplicate    Int          @default(0)
  assetsUpdated      Int          @default(0)
  assignmentsCreated Int          @default(0)
  employeesCreated   Int          @default(0)
  employeesUpdated   Int          @default(0)
  assets             Asset[]
  uploadedBy         SystemUser   @relation(fields: [uploadedById], references: [id])
  rows               ImportRow[]

  @@index([uploadedById])
}

model ImportRow {
  id           String        @id @default(cuid())
  importId     String
  rowIndex     Int
  rawData      Json
  mappedData   Json
  outcome      RowOutcome?
  assetId      String?
  errorMessage String?
  isDuplicate  Boolean       @default(false)
  wasEdited    Boolean       @default(false)
  conflictKey  String?
  employeeHint String?
  createdAt    DateTime      @default(now())
  import       ImportHistory @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, rowIndex])
}

model ColumnMappingPreset {
  id           String     @id @default(cuid())
  name         String
  categoryHint String?
  mappings     Json
  isShared     Boolean    @default(false)
  createdById  String
  createdAt    DateTime   @default(now())
  createdBy    SystemUser @relation(fields: [createdById], references: [id])
}

model ScanRoom {
  id         String         @id @default(cuid())
  roomCode   String         @unique
  ownerId    String
  status     ScanRoomStatus @default(open)
  maxDevices Int            @default(5)
  createdAt  DateTime       @default(now())
  expiresAt  DateTime
  devices    ScanDevice[]
  results    ScanResult[]
  owner      SystemUser     @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([expiresAt])
}

model ScanDevice {
  id          String           @id @default(cuid())
  roomId      String
  deviceToken String           @unique
  deviceLabel String
  status      ScanDeviceStatus @default(waiting)
  connectedAt DateTime?
  lastSeenAt  DateTime?
  room        ScanRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  results     ScanResult[]

  @@index([roomId])
}

model ScanResult {
  id           String           @id @default(cuid())
  roomId       String
  deviceId     String
  parsedData   Json
  rawLines     Json
  status       ScanResultStatus @default(pending)
  rejectReason String?
  assetId      String?
  scannedAt    DateTime         @default(now())
  device       ScanDevice       @relation(fields: [deviceId], references: [id])
  room         ScanRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([status, scannedAt])
}

enum AssetCondition {
  usable
  for_repair
  for_disposal
}

enum OwnershipType {
  company
  personal
}

enum MovementType {
  assignment
  transfer
  site_transfer
  resignation
  new_hire
  repair_send
  repair_return
  disposal
  lost_report
  stolen_report
  recovery
  return_requested
  return_approved
  return_rejected
}

enum AssignmentStatus {
  active
  returned
  transferred
  pending_return
}

model StockItem {
  id                 String             @id @default(cuid())
  sku                String             @unique
  idempotencyKey     String             @unique
  requestFingerprint String
  name               String
  category           String
  unitOfMeasure      String
  description        String?
  isSerialized       Boolean            @default(false)
  active             Boolean            @default(true)
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  movements          StockMovement[]
  policies           StockLevelPolicy[]
  countLines         StockCountLine[]
}

model StockLocation {
  id            String              @id @default(cuid())
  branchId      String
  name          String
  locationType  StockLocationType
  description   String?
  archivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     StockLedgerEntry[]
  policies      StockLevelPolicy[]
  countSessions StockCountSession[]
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, archivedAt])
}

model StockMovement {
  id                 String             @id @default(cuid())
  stockItemId        String
  movementType       StockMovementType
  quantity           Decimal            @db.Decimal(18, 3)
  reason             String?
  referenceType      String?
  referenceId        String?
  idempotencyKey     String             @unique
  requestFingerprint String
  performedById      String
  approvedById       String?
  approvedAt         DateTime?
  relatedEmployeeId  String?
  relatedAssetId     String?
  createdAt          DateTime           @default(now())
  stockItem          StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  entries            StockLedgerEntry[]
  performedBy        SystemUser         @relation("StockMovementPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  approvedBy         SystemUser?        @relation("StockMovementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  relatedEmployee    Employee?          @relation(fields: [relatedEmployeeId], references: [id], onDelete: SetNull)
  relatedAsset       Asset?             @relation(fields: [relatedAssetId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
}

model StockLedgerEntry {
  id            String        @id @default(cuid())
  movementId    String
  locationId    String
  quantityDelta Decimal       @db.Decimal(18, 3)
  createdAt     DateTime      @default(now())
  movement      StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  location      StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([locationId, createdAt])
}

model StockLevelPolicy {
  id              String        @id @default(cuid())
  stockItemId     String
  locationId      String
  minimumQuantity Decimal       @db.Decimal(18, 3)
  reorderQuantity Decimal       @db.Decimal(18, 3)
  updatedAt       DateTime      @updatedAt
  stockItem       StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, locationId])
}

model StockCountSession {
  id                        String           @id @default(cuid())
  locationId                String
  status                    StockCountStatus @default(draft)
  startedById               String
  submittedAt               DateTime?
  approvedById              String?
  approvedAt                DateTime?
  expectedUpdatedAt         DateTime         @updatedAt
  idempotencyKey            String           @unique
  approvalIdempotencyKey    String?          @unique
  approvalReason            String?
  approvalExpectedUpdatedAt DateTime?
  location                  StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines                     StockCountLine[]
  startedBy                 SystemUser       @relation("StockCountStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  approvedBy                SystemUser?      @relation("StockCountApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
}

model StockCountLine {
  id                       String            @id @default(cuid())
  sessionId                String
  stockItemId              String
  expectedQuantitySnapshot Decimal           @db.Decimal(18, 3)
  countedQuantity          Decimal           @db.Decimal(18, 3)
  variance                 Decimal           @db.Decimal(18, 3)
  session                  StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stockItem                StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, stockItemId])
}

